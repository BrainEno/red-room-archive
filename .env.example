ADMIN_TOKEN=change-me-to-a-long-random-string
# Public origin, used for canonical links, RSS and the sitemap.
# SITE_URL=https://archive.example

# Notion (can also be set in /admin → Settings, which takes precedence).
# NOTION_DATABASE_ID accepts an id or the database link.
NOTION_TOKEN=
NOTION_DATABASE_ID=

# SYNC_TTL_SECONDS=300
# NOTION_TIMEOUT_MS=15000
# MEDIA_CACHE_DIR=data/notion-media
# MAX_MEDIA_MB=50
# DB_PATH=data/archive.db
# UPLOAD_DIR=data/uploads
# MAX_UPLOAD_MB=300
# MAX_JSON_KB=256
# Bookmark cards: the server reads the title/summary of bookmarked pages (off disables).
# LINK_PREVIEWS=on
# Optional: pin the Notion webhook verification token instead of the /admin handshake.
# NOTION_WEBHOOK_TOKEN=

# Newsletter (double opt-in). Sign-up stays closed until the first four are set.
# On Netlify, set these for the Functions scope and the Production context only.
# NEWSLETTER_SECRET=        # >= 32 random characters: openssl rand -base64 48 (back it up offline)
# NEWSLETTER_EMAIL_PROVIDER=resend   # resend | brevo
# NEWSLETTER_EMAIL_API_KEY=
# NEWSLETTER_FROM=SureShot Archive <letters@archive.example>
# NEWSLETTER_REPLY_TO=
# Sending limits, counted for every email (UTC day / UTC month). Defaults stay under
# Resend's free tier (100/day, 3,000/month). Lower them if the account sends other mail.
# NEWSLETTER_DAILY_LIMIT=90
# NEWSLETTER_MONTHLY_LIMIT=2800
# NEWSLETTER_TOKEN_TTL_HOURS=48
# NEWSLETTER_SITE_NAME=SureShot Archive
# Public sign-up entry points (homepage, article end, footer, sitemap) are hidden
# by default; /subscribe, email links and /admin keep working. Set to 1 to show them.
# Node: Admin → Settings → Newsletter overrides this instantly. Static/Netlify: a
# build variable (scope Builds) — redeploy after changing it.
# SHOW_NEWSLETTER_SIGNUP=1
