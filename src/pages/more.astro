---
// Route: /more — self-published books, excerpts, contact (content/more.ts).
import MoreView from '../ui/views/MoreView.astro';
import { getMore, getSite } from '../server/queries.ts';

const site = getSite(Astro.locals.locale);
const more = getMore(site.locale);
---
<MoreView site={site} more={more} />
