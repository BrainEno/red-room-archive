---
// Route: /topics/:slug/page/:n (n ≥ 2)
import ArticlesView from '../../../../ui/views/ArticlesView.astro';
import NotFoundView from '../../../../ui/views/NotFoundView.astro';
import { getSite, getTopic } from '../../../../server/queries.ts';
import { localePath } from '../../../../shared/i18n.ts';
import { topicPath } from '../../../../shared/routes.ts';
import { parsePageParam } from '../../../../ui/paging.ts';

const site = getSite(Astro.locals.locale);
const param = parsePageParam(Astro.params.n);
const slug = Astro.params.slug ?? '';
const data = param.ok || param.redirectToFirst ? await getTopic({ slug, page: param.ok ? param.page : 1, locale: site.locale }) : { status: 'missing' as const };
if (data.status === 'redirect') return Astro.redirect(localePath(topicPath(data.slug, param.ok ? param.page : 1), site.locale), 301);
if (data.status === 'ok' && !param.ok) return Astro.redirect(localePath(topicPath(data.tag.slug), site.locale), 301);
const found = data.status === 'ok' && data.page <= data.pages;
if (!found) Astro.response.status = 404;
---
{found && data.status === 'ok' ? <ArticlesView site={site} articles={data.articles} total={data.total} page={data.page} pages={data.pages} tag={data.tag} tags={data.tags} /> : <NotFoundView site={site} />}
