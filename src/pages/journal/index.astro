---
// Route: /journal?tag=&page=
import JournalView from '../../ui/views/JournalView.astro';
import { getJournal, getSite } from '../../server/queries.ts';

const site = getSite();
const page = Number(Astro.url.searchParams.get('page')) || 1;
const tag = Astro.url.searchParams.get('tag') ?? undefined;
const journal = getJournal({ page, tag });
if (page > journal.pages) Astro.response.status = 404;
---
<JournalView site={site} {...journal} />
