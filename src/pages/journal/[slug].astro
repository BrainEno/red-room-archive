---
import Base from '../../layouts/Base.astro';
import { getPost } from '../../lib/db';
import { renderMarkdown } from '../../lib/markdown';
const p = getPost(Astro.params.slug!);
if (!p) return Astro.redirect('/journal');
const html = await renderMarkdown(p.body ?? '');
---
<Base title={p.title} bodyClass="plain">
  <a class="back" href="/journal">← Journal</a>
  <article class="prose">
    <h1>{p.title}</h1>
    <p class="by">{String(p.created).slice(0, 10)}{p.tags ? ` · ${p.tags}` : ''}</p>
    <Fragment set:html={html} />
  </article>
</Base>
