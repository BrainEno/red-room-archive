---
// Route: /journal/:slug — drafts are indistinguishable from missing posts.
import JournalPostView from '../../ui/views/JournalPostView.astro';
import NotFoundView from '../../ui/views/NotFoundView.astro';
import { getJournalPost, getSite } from '../../server/queries.ts';

const site = getSite();
const view = await getJournalPost(Astro.params.slug ?? '');
if (!view) Astro.response.status = 404;
---
{view ? <JournalPostView site={site} {...view} /> : <NotFoundView site={site} />}
