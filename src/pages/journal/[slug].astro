---
import Base from '../../layouts/Base.astro';
import { getPost } from '../../lib/db';
import { esc } from '../../lib/notion';
const p = getPost(Astro.params.slug!);
if (!p) return Astro.redirect('/');
const html = p.body.split(/\n{2,}/).map((x: string) => `<p>${esc(x)}</p>`).join('');
---
<Base title={p.title} bodyClass="plain">
  <a class="back" href="/">Home</a>
  <article class="prose">
    <h1>{p.title}</h1>
    <p class="by">{String(p.created).slice(0, 10)}{p.tags ? ` · ${p.tags}` : ''}</p>
    <Fragment set:html={html} />
  </article>
</Base>
