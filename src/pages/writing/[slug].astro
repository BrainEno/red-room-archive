---
import Base from '../../layouts/Base.astro';
import { getBody, getItem } from '../../lib/db.ts';
const item = await getItem('writing', Astro.params.slug!);
if (!item) return Astro.redirect('/#works');
const body = await getBody(item);
---
<Base title={item.title} bodyClass="plain">
  <a class="back" href="/#works">Works</a>
  <article class="prose">
    <h1>{item.title}</h1>
    <p class="by">{[item.data.type, item.data.year].filter(Boolean).join(', ')}</p>
    <Fragment set:html={body} />
  </article>
</Base>
