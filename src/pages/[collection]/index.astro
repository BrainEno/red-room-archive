---
// Route: /works · /music · /video
import CollectionView from '../../ui/views/CollectionView.astro';
import NotFoundView from '../../ui/views/NotFoundView.astro';
import { getCollection, getSite } from '../../server/queries.ts';
import { collectionBySlug } from '../../shared/kinds.ts';

// The old machine name of a collection redirects to its public name.
if (Astro.params.collection === 'writing') return Astro.redirect('/works', 301);
if (Astro.params.collection === 'films') return Astro.redirect('/video', 301);

const site = getSite();
const collection = collectionBySlug(Astro.params.collection ?? '');
const items = collection ? await getCollection(collection.kind) : [];
const type = Astro.url.searchParams.get('type') ?? undefined;
if (!collection) Astro.response.status = 404;
---
{collection ? <CollectionView site={site} collection={collection} items={items} type={type} /> : <NotFoundView site={site} />}
