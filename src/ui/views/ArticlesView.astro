---
import Page from '../layouts/Page.astro';
import ArticleList from '../components/ArticleList.astro';
import Pager from '../components/Pager.astro';
import type { ArticleSummary, TagCount } from '../../shared/contracts.ts';
import { ARTICLES_PATH, tagPath } from '../../shared/routes.ts';

export interface Props {
  site: { name: string; url: string; email: string; articles: { label: string; intro: string } };
  articles: ArticleSummary[];
  page: number;
  pages: number;
  total: number;
  tag?: string;
  tags: TagCount[];
}
const { site, articles, page, pages, total, tag, tags } = Astro.props;
const query = (p: number) => {
  const params = new URLSearchParams();
  if (tag) params.set('tag', tag);
  if (p > 1) params.set('page', String(p));
  const text = params.toString();
  return `${ARTICLES_PATH}${text ? `?${text}` : ''}`;
};
const heading = tag ? `#${tag}` : site.articles.label;
const same = (a: string, b?: string) => a.toLowerCase() === b?.toLowerCase();
---
<Page title={`${tag ? `${heading} — ` : ''}${site.articles.label} — ${site.name}`} siteName={site.name} siteUrl={site.url} email={site.email} description={site.articles.intro} current={ARTICLES_PATH} noindex={page > 1}>
  <section class="prose listing">
    <p class="article-label">{site.name} / {site.articles.label}</p>
    <h1>{heading}</h1>
    <p class="article-intro">{tag ? `${total} ${total === 1 ? 'article' : 'articles'} tagged “${tag}”.` : site.articles.intro}</p>

    {tags.length > 0 && (
      <nav class="filters" aria-label="Tags">
        <a href={ARTICLES_PATH} aria-current={!tag ? "page" : undefined}>All</a>
        {tags.map((t) => (
          <a href={tagPath(t.name)} aria-current={same(t.name, tag) ? 'page' : undefined}>{t.name}<sup>{t.count}</sup></a>
        ))}
      </nav>
    )}

    <ArticleList articles={articles} showExcerpt showCovers empty={tag ? 'No articles with this tag.' : 'Nothing published yet.'} />
    <Pager page={page} pages={pages} href={query} />
  </section>
</Page>
