---
import Page from '../layouts/Page.astro';
import ArticleList from '../components/ArticleList.astro';
import Pager from '../components/Pager.astro';
import { messages } from '../i18n.ts';
import type { ArticleSummary, TagCount } from '../../shared/contracts.ts';
import { contentLang, localePath, type Locale } from '../../shared/i18n.ts';
import { ARCHIVE_PATH, ARTICLES_PATH, TOPICS_PATH, articlesPagePath, topicPath } from '../../shared/routes.ts';
import { absoluteUrl, breadcrumbLd } from '../../shared/structured-data.ts';

export interface Props {
  site: { locale: Locale; name: string; url: string; email: string; articlesIntro: string };
  articles: ArticleSummary[];
  page: number;
  pages: number;
  total: number;
  tag?: { key: string; slug: string; name: string };
  tags: TagCount[];
}
const { site, articles, page, pages, total, tag, tags } = Astro.props;
const { locale } = site;
const t = messages(locale).articles;
const to = (path: string) => localePath(path, locale);
const pageHref = (p: number) => to(tag ? topicPath(tag.slug, p) : articlesPagePath(p));
const heading = tag ? `#${tag.name}` : t.title;
const nav = messages(locale).nav;
const abs = (path: string) => absoluteUrl(site.url, localePath(path, locale));
const jsonLd =
  site.url && tag
    ? [breadcrumbLd([{ name: nav.home, url: abs('/') }, { name: nav.topicsLink, url: abs(TOPICS_PATH) }, { name: tag.name, url: abs(topicPath(tag.slug)) }])]
    : [];
---
<Page title={`${tag ? `${heading} — ` : ''}${t.title} — ${site.name}`} siteName={site.name} siteUrl={site.url} email={site.email} locale={locale} description={site.articlesIntro} current={tag ? TOPICS_PATH : ARTICLES_PATH} noindex={page > 1} jsonLd={jsonLd}>
  <section class="prose listing">
    <p class="article-label">{site.name} / {t.title}</p>
    <h1 lang={tag ? contentLang(tag.name) : undefined}>{heading}</h1>
    <p class="article-intro">{tag ? t.tagged(total, tag.name) : site.articlesIntro}</p>

    {tags.length > 0 && (
      <nav class="filters" aria-label={t.tags}>
        <a href={to(ARTICLES_PATH)} aria-current={!tag ? 'page' : undefined}>{t.all}</a>
        {tags.map((item) => (
          <a href={to(topicPath(item.slug))} aria-current={item.key === tag?.key ? 'page' : undefined} lang={contentLang(item.name)}>{item.name}<sup>{item.count}</sup></a>
        ))}
      </nav>
    )}

    <ArticleList articles={articles} locale={locale} showExcerpt showCovers empty={tag ? t.noneTagged : t.empty} />
    <Pager page={page} pages={pages} locale={locale} href={pageHref} />
    <p class="listing-links"><a href={to(TOPICS_PATH)}>{t.allTopics}</a><a href={to(ARCHIVE_PATH)}>{t.archive}</a></p>
  </section>
</Page>
