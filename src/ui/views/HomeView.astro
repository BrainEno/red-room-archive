---
/**
 * Homepage: neon sign → intro → Latest / Featured / Topics → More (link to /more + email).
 * The markup ids/classes are the contract with ui/scripts/site/home.ts (each
 * section id drives one camera move).
 */
import Base from '../layouts/Base.astro';
import LangSwitch from '../components/LangSwitch.astro';
import { messages } from '../i18n.ts';
import '../styles/home.css';
import type { ArticleSummary, TagCount } from '../../shared/contracts.ts';
import { contentLang, localePath, type Locale } from '../../shared/i18n.ts';
import { ARTICLES_PATH, COPYRIGHT_PATH, MORE_PATH, SEARCH_PATH, SUBSCRIBE_PATH, TOPICS_PATH, topicPath } from '../../shared/routes.ts';
import { absoluteUrl, websiteLd } from '../../shared/structured-data.ts';
import { splitQuote } from '../../core/quote.ts';

export interface Props {
  site: {
    locale: Locale;
    name: string;
    email: string;
    about: string;
    intro: string;
    tagline: string;
    url: string;
    facts: { key: string; value: string }[];
    newsletterSignup?: boolean;
  };
  home: {
    latest: ArticleSummary[]; featured: ArticleSummary[]; topics: TagCount[]; total: number; model: string;
    announce: { kicker: string; title: string; action: string; subject: string };
  };
}

const { site, home } = Astro.props;
const { locale } = site;
const t = messages(locale);
const to = (path: string) => localePath(path, locale);
const TOPIC_LIMIT = 12;
const pad = (i: number) => String(i + 1).padStart(2, '0');
const year = (date: string) => String(date).slice(0, 4);
const nav = ['intro', 'latest', 'topics', 'more'] as const;
// The large intro slot: the intro, or else the about line — with a trailing
// attribution (`…战斗。——作者`) set on its own line.
const lede = site.intro ? { quote: site.intro, cite: '' } : splitQuote(site.about);
const ledeLang = contentLang(lede.quote);
// First-screen notice beside the sign (a forthcoming book): the action writes to the site email.
const notice = home.announce.title ? home.announce : undefined;
const noticeHref = notice && (site.email
  ? `mailto:${site.email}${notice.subject ? `?subject=${encodeURIComponent(notice.subject)}` : ''}`
  : to(MORE_PATH));
const jsonLd = site.url
  ? [websiteLd({ url: absoluteUrl(site.url, to('/')), name: site.name, description: site.about, inLanguage: locale, searchUrl: absoluteUrl(site.url, to(SEARCH_PATH)) })]
  : [];
---
<Base title={site.name} siteName={site.name} siteUrl={site.url} description={site.about} locale={locale} jsonLd={jsonLd}>
  <a class="skip" href="#content">{t.page.skip}</a>
  <canvas id="gl" aria-hidden="true" data-model={home.model}></canvas>
  <div class="scrim" aria-hidden="true"></div>
  <div id="neon" class="neon"><div class="sign" aria-hidden="true"><div class="cam"><canvas></canvas></div></div></div>
  <div class="grain" aria-hidden="true"></div>
  <div class="loader"><span class="count">000</span></div>
  <noscript><link rel="stylesheet" href="/noscript.css" /></noscript>

  <header class="bar">
    <a class="brand" href="#home">{site.name}</a>
    <nav>
      {nav.map((id) => <a href={`#${id}`}>{t.nav[id]}</a>)}
      <LangSwitch locale={locale} />
    </nav>
  </header>

  <main id="content" tabindex="-1">
    <section id="home" class="s">
      <h1 class="sr">{site.name}</h1>
      {notice && (
        <aside class="notice" aria-label={notice.kicker || notice.title}>
          {notice.kicker && <p class="notice-k">{notice.kicker}</p>}
          <p class="notice-t" lang={contentLang(notice.title)}>{notice.title}</p>
          {notice.action && <a class="notice-a" href={noticeHref}><span class="dot" aria-hidden="true"></span><span class="notice-l">{notice.action}</span><span class="arr" aria-hidden="true">→</span></a>}
        </aside>
      )}
      <div class="meta"><span>{site.name}</span><span>{site.tagline}</span><span>{t.home.scroll}</span></div>
    </section>

    <section id="intro" class="intro">
      <div class="stage">
        <div class="intro-copy" data-script={lede.cite && ledeLang === 'zh-CN' ? 'cjk' : undefined}>
          {/* No intro: the about line takes the large word-by-word slot. */}
          {site.intro && <p class="site-about" lang={contentLang(site.about)}>{site.about}</p>}
          {lede.cite ? (
            <figure class="lede-quote">
              <blockquote><p class="lede" lang={ledeLang}>{lede.quote.split('\n').map((line, index) => (
                <>{index > 0 && <br class="lede-break" />}{line}</>
              ))}</p></blockquote>
              <figcaption class="lede-by" lang={contentLang(lede.cite)}>{lede.cite}</figcaption>
            </figure>
          ) : <p class="lede" lang={ledeLang}>{lede.quote}</p>}
        </div>
        {site.facts.length > 0 && (
          <dl class="facts">{site.facts.map((f) => <div><dt lang={contentLang(f.key)}>{f.key}</dt><dd lang={contentLang(f.value)}>{f.value}</dd></div>)}</dl>
        )}
      </div>
    </section>

    <section id="latest" class="s l">
      <h2 class="sec">{t.home.latest}<sup>{home.total}</sup></h2>
      <ul class="list">{home.latest.map((a, i) => (
        <li><a class="row" href={to(a.href)}><span class="n">{pad(i)}</span><span class="t" lang={contentLang(a.title)}>{a.title}</span><span>{a.tags[0] ?? ''}</span><span>{year(a.date)}</span><span class="r"></span></a></li>
      ))}</ul>
      {home.total > 0
        ? <a class="more" href={to(ARTICLES_PATH)}>{t.home.allArticles}</a>
        : <p class="empty-note">{t.home.nothingYet}</p>}
    </section>

    <section id="featured" class="s l">
      <h2 class="sec">{t.home.featured}<sup>{home.featured.length}</sup></h2>
      <ul class="list">{home.featured.map((a, i) => (
        <li><a class="row" href={to(a.href)}><span class="n">{pad(i)}</span><span class="t" lang={contentLang(a.title)}>{a.title}</span><span>{a.tags[0] ?? ''}</span><span>{year(a.date)}</span><span class="r"></span></a></li>
      ))}</ul>
      {home.featured.length === 0 && home.total > 0 && <a class="more" href={to(ARTICLES_PATH)}>{t.home.readArchive}</a>}
    </section>

    <section id="topics" class="s l">
      <h2 class="sec">{t.home.topics}<sup>{home.topics.length}</sup></h2>
      <ul class="list">
        <li><a class="row" href={to(ARTICLES_PATH)}><span class="n">00</span><span class="t">{t.articles.all}</span><span></span><span>{home.total}</span><span class="r"></span></a></li>
        {home.topics.slice(0, TOPIC_LIMIT).map((topic, i) => (
          <li><a class="row" href={to(topicPath(topic.slug))}><span class="n">{pad(i)}</span><span class="t" lang={contentLang(topic.name)}>{topic.name}</span><span></span><span>{topic.count}</span><span class="r"></span></a></li>
        ))}
      </ul>
      {home.topics.length > TOPIC_LIMIT && <a class="more" href={to(TOPICS_PATH)}>{t.home.allTopics}</a>}
    </section>

    <section id="more" class="s finale" aria-labelledby="more-h">
      <h2 id="more-h" class="sr">{t.home.more}</h2>
      <span id="contact" aria-hidden="true"></span>{/* old /#contact links still land here */}
      <p class="go-hint">{t.home.moreHint}</p>
      <a class="go" href={to(MORE_PATH)}><span class="go-t">{t.home.learnMore}</span><span class="go-a" aria-hidden="true">↗</span></a>
      <div class="reach">
        {site.email && <p><span class="k">{t.home.email}</span><a href={`mailto:${site.email}`}>{site.email}</a></p>}
        {site.newsletterSignup && <p class="letters-reach"><span class="k">{t.newsletter.homeKey}</span><a href={to(SUBSCRIBE_PATH)}>{t.newsletter.homeLink}</a></p>}
        <p class="what">{t.home.moreTopics}</p>
        <p class="yr"><a href={to(COPYRIGHT_PATH)} title={t.legal.copyright}>© {new Date().getFullYear()} {site.name}</a></p>
      </div>
    </section>
  </main>

  <script>import '../scripts/site/home.ts';</script>
</Base>
