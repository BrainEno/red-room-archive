---
/**
 * Homepage: neon sign → intro → Latest / Featured / Topics → More (link to /more + email).
 * The markup ids/classes are the contract with ui/scripts/site/home.ts (each
 * section id drives one camera move).
 */
import Base from '../layouts/Base.astro';
import LangSwitch from '../components/LangSwitch.astro';
import { messages } from '../i18n.ts';
import '../styles/home.css';
import type { ArticleSummary, TagCount } from '../../shared/contracts.ts';
import { contentLang, type Locale } from '../../shared/i18n.ts';
import { ARTICLES_PATH, MORE_PATH, tagPath } from '../../shared/routes.ts';

export interface Props {
  site: {
    locale: Locale;
    name: string;
    email: string;
    about: string;
    intro: string;
    tagline: string;
    url: string;
    facts: { key: string; value: string }[];
  };
  home: { latest: ArticleSummary[]; featured: ArticleSummary[]; topics: TagCount[]; total: number };
}

const { site, home } = Astro.props;
const { locale } = site;
const t = messages(locale);
const TOPIC_LIMIT = 12;
const pad = (i: number) => String(i + 1).padStart(2, '0');
const year = (date: string) => String(date).slice(0, 4);
const nav = ['intro', 'latest', 'topics', 'more'] as const;
---
<Base title={site.name} siteName={site.name} siteUrl={site.url} description={site.about} locale={locale}>
  <canvas id="gl" aria-hidden="true"></canvas>
  <div id="neon" class="neon"><div class="sign" aria-hidden="true"><div class="cam"><canvas></canvas></div></div></div>
  <div class="grain" aria-hidden="true"></div>
  <div class="loader"><span class="count">000</span></div>

  <header class="bar">
    <a class="brand" href="#home">{site.name}</a>
    <nav>
      {nav.map((id) => <a href={`#${id}`}>{t.nav[id]}</a>)}
      <LangSwitch locale={locale} />
    </nav>
  </header>

  <main>
    <section id="home" class="s">
      <h1 class="sr">{site.name}</h1>
      <div class="meta"><span>{site.name}</span><span>{site.tagline}</span><span>{t.home.scroll}</span></div>
    </section>

    <section id="intro" class="intro">
      <div class="stage">
        <div class="intro-copy">
          <p class="site-about" lang={contentLang(site.about)}>{site.about}</p>
          <p class="lede" lang={contentLang(site.intro)}>{site.intro}</p>
        </div>
        <dl class="facts">{site.facts.map((f) => <div><dt>{f.key}</dt><dd>{f.value}</dd></div>)}</dl>
      </div>
    </section>

    <section id="latest" class="s l">
      <h2 class="sec">{t.home.latest}<sup>{home.total}</sup></h2>
      <ul class="list">{home.latest.map((a, i) => (
        <li><a class="row" href={a.href}><span class="n">{pad(i)}</span><span class="t" lang={contentLang(a.title)}>{a.title}</span><span>{a.tags[0] ?? ''}</span><span>{year(a.date)}</span><span class="r"></span></a></li>
      ))}</ul>
      {home.total > 0
        ? <a class="more" href={ARTICLES_PATH}>{t.home.allArticles}</a>
        : <p class="empty-note">{t.home.nothingYet}</p>}
    </section>

    <section id="featured" class="s l">
      <h2 class="sec">{t.home.featured}<sup>{home.featured.length}</sup></h2>
      <ul class="list">{home.featured.map((a, i) => (
        <li><a class="row" href={a.href}><span class="n">{pad(i)}</span><span class="t" lang={contentLang(a.title)}>{a.title}</span><span>{a.tags[0] ?? ''}</span><span>{year(a.date)}</span><span class="r"></span></a></li>
      ))}</ul>
      {home.featured.length === 0 && home.total > 0 && <a class="more" href={ARTICLES_PATH}>{t.home.readArchive}</a>}
    </section>

    <section id="topics" class="s l">
      <h2 class="sec">{t.home.topics}<sup>{home.topics.length}</sup></h2>
      <ul class="list">{home.topics.slice(0, TOPIC_LIMIT).map((topic, i) => (
        <li><a class="row" href={tagPath(topic.key)}><span class="n">{pad(i)}</span><span class="t" lang={contentLang(topic.name)}>{topic.name}</span><span></span><span>{topic.count}</span><span class="r"></span></a></li>
      ))}</ul>
      {home.topics.length > TOPIC_LIMIT && <a class="more" href={ARTICLES_PATH}>{t.home.allTopics}</a>}
    </section>

    <section id="more" class="s finale" aria-labelledby="more-h">
      <h2 id="more-h" class="sr">{t.home.more}</h2>
      <span id="contact" aria-hidden="true"></span>{/* old /#contact links still land here */}
      <a class="go" href={MORE_PATH}><span class="go-t">{t.home.learnMore}</span><span class="go-a" aria-hidden="true">↗</span></a>
      <div class="reach">
        {site.email && <p><span class="k">{t.home.email}</span><a href={`mailto:${site.email}`}>{site.email}</a></p>}
        <p class="what">{t.home.moreTopics}</p>
        <p class="yr">© {new Date().getFullYear()} {site.name}</p>
      </div>
    </section>
  </main>

  <script>import '../scripts/site/home.ts';</script>
</Base>
