---
import Page from '../layouts/Page.astro';
import { messages } from '../i18n.ts';
import type { Locale } from '../../shared/i18n.ts';
import { ARTICLES_PATH } from '../../shared/routes.ts';

export interface Props {
  site: { locale: Locale; name: string; url: string; email: string };
}
const { site } = Astro.props;
const t = messages(site.locale);
---
<Page title={`${t.notFound.title} — ${site.name}`} siteName={site.name} siteUrl={site.url} email={site.email} locale={site.locale} noindex>
  <section class="prose notfound">
    <p class="kicker">404</p>
    <h1>{t.notFound.heading}</h1>
    <p>{t.notFound.body}</p>
    <p><a href="/">{t.nav.home}</a> · <a href={ARTICLES_PATH}>{t.notFound.allArticles}</a> · <a href="/search">{t.nav.search}</a></p>
  </section>
</Page>
