---
import Page from '../layouts/Page.astro';
import { messages } from '../i18n.ts';
import { localePath, type Locale } from '../../shared/i18n.ts';
import { ARTICLES_PATH, SEARCH_PATH } from '../../shared/routes.ts';

export interface Props {
  site: { locale: Locale; name: string; url: string; email: string; newsletterSignup?: boolean; analytics?: boolean };
}
const { site } = Astro.props;
const t = messages(site.locale);
---
<Page title={`${t.notFound.title} — ${site.name}`} siteName={site.name} siteUrl={site.url} email={site.email} newsletter={site.newsletterSignup} locale={site.locale} noindex>
  <section class="prose notfound">
    <p class="kicker">404</p>
    <h1>{t.notFound.heading}</h1>
    <p>{t.notFound.body}</p>
    <p><a href={localePath('/', site.locale)}>{t.nav.home}</a> · <a href={localePath(ARTICLES_PATH, site.locale)}>{t.notFound.allArticles}</a> · <a href={localePath(SEARCH_PATH, site.locale)}>{t.nav.search}</a></p>
  </section>
</Page>
