---
import Page from '../layouts/Page.astro';
import ArticleList from '../components/ArticleList.astro';
import type { SearchResponse } from '../../shared/contracts.ts';

export interface Props {
  site: { name: string; url: string; email: string };
  result: SearchResponse;
}
const { site, result } = Astro.props;
const hasQuery = Boolean(result.query);
---
<Page title={`${hasQuery ? `“${result.query}” — ` : ''}Search — ${site.name}`} siteName={site.name} siteUrl={site.url} email={site.email} current="/search" noindex>
  <section class="prose listing">
    <p class="article-label">{site.name} / Search</p>
    <h1>Search</h1>
    <form class="search" role="search" action="/search" method="get">
      <label class="sr" for="q">Search articles</label>
      <input id="q" name="q" type="search" value={result.query} placeholder="Titles, tags, text…" autofocus={!hasQuery} maxlength="120" />
      <button>Search</button>
    </form>

    {hasQuery && (
      <p class="article-intro" role="status">{result.total} {result.total === 1 ? 'result' : 'results'} for “{result.query}”.</p>
    )}
    {result.articles.length > 0 && (
      <section class="results">
        <ArticleList articles={result.articles} showExcerpt />
      </section>
    )}
    {hasQuery && result.total === 0 && <p class="empty">Nothing matched. Try a shorter word or a tag.</p>}
  </section>
</Page>
