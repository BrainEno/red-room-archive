---
/**
 * Pages opened from emails: /newsletter/confirm and /newsletter/unsubscribe.
 * The token travels in the URL fragment (#token=…), which browsers never send
 * to a server, so it stays out of access logs and Referer headers. Nothing
 * happens on load — link scanners open these pages too — only on a click.
 */
import Page from '../layouts/Page.astro';
import '../styles/newsletter.css';
import { messages } from '../i18n.ts';
import { localePath, type Locale } from '../../shared/i18n.ts';
import { ARTICLES_PATH, SUBSCRIBE_PATH } from '../../shared/routes.ts';

export interface Props {
  site: { locale: Locale; name: string; url: string; email: string; newsletterSignup?: boolean; analytics?: boolean };
  action: 'confirm' | 'unsubscribe';
}
const { site, action } = Astro.props;
const { locale } = site;
const n = messages(locale).newsletter;
const t = action === 'confirm' ? n.confirm : n.unsubscribe;
const payload = JSON.stringify({ ...t, unreachable: n.status.unreachable, rateLimited: n.status.rateLimited, error: n.status.error });
---
<Page title={`${t.title} — ${site.name}`} siteName={site.name} siteUrl={site.url} email={site.email} newsletter={site.newsletterSignup} locale={locale} noindex>
  <section class="prose letters letters-link" data-newsletter-link={action} data-messages={payload}>
    <p class="article-label">{site.name} / {n.title}</p>
    <h1>{t.title}</h1>
    <p class="letters-lede">{t.lede}</p>
    <div class="letters-act">
      <button type="button" class="letters-button" data-newsletter-act hidden>{t.button}<span aria-hidden="true"> →</span></button>
    </div>
    <p class="letters-status" role="status" aria-live="polite" data-newsletter-status></p>
    <p class="letters-next" data-newsletter-next hidden>
      <a href={localePath(SUBSCRIBE_PATH, locale)} data-next="again">{t.again}</a>
      {action === 'confirm' && <a href={localePath(ARTICLES_PATH, locale)} data-next="read">{n.confirm.read}</a>}
    </p>
    <noscript><p class="letters-status" data-state="error">{n.noscript}</p></noscript>
  </section>
  <script>import '../scripts/site/newsletter.ts';</script>
</Page>
