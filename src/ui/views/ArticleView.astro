---
import Page from '../layouts/Page.astro';
import PrevNext from '../components/PrevNext.astro';
import { messages } from '../i18n.ts';
import { formatDate, isoDatetime } from '../../core/text.ts';
import type { ArticleDetail } from '../../shared/contracts.ts';
import { contentLang, type Locale } from '../../shared/i18n.ts';
import { ARTICLES_PATH, tagPath } from '../../shared/routes.ts';

export interface Props {
  site: { locale: Locale; name: string; url: string; email: string };
  article: ArticleDetail;
  bodyMissing: boolean;
}
const { site, article, bodyMissing } = Astro.props;
const { locale } = site;
const t = messages(locale);
const showToc = article.toc.length >= 3;
/** The article's own language (from its title and excerpt), independent of the interface language. */
const lang = contentLang(`${article.title} ${article.excerpt}`);
---
<Page title={`${article.title} — ${site.name}`} siteName={site.name} siteUrl={site.url} email={site.email} locale={locale} description={article.excerpt || site.name} image={article.cover} current={ARTICLES_PATH} type="article">
  <div class="article-wrap">
    <article class="prose" lang={lang}>
      <p class="kicker" lang={locale}><a href={ARTICLES_PATH}>{t.articles.title}</a></p>
      <h1>{article.title}</h1>
      <p class="by" lang={locale}>
        <time datetime={isoDatetime(article.date)}>{formatDate(article.date, locale, { time: true })}</time>
        <span> · {t.article.readingTime(article.readingMinutes)}</span>
      </p>
      {article.tags.length > 0 && (
        <p class="tags">{article.tags.map((tag) => <a href={tagPath(tag)}>{tag}</a>)}</p>
      )}
      {article.cover && <img class="cover" src={article.cover} alt="" decoding="async" fetchpriority="high" />}
      <div class:list={['article-body', { 'text-only': !article.cover }]}>
        {bodyMissing
          ? <p class="body-missing" lang={locale}>{t.article.unavailable}</p>
          : <Fragment set:html={article.html} />}
      </div>
    </article>
    {showToc && (
      <aside class="article-aside">
        <nav aria-label={t.article.contents}>
          <h2>{t.article.contents}</h2>
          <ol lang={lang}>{article.toc.map((entry) => <li class={`toc-l${entry.level}`}><a href={`#${entry.id}`}>{entry.text}</a></li>)}</ol>
        </nav>
      </aside>
    )}
  </div>
  <PrevNext locale={locale} previous={article.previous ?? undefined} next={article.next ?? undefined} />
</Page>
