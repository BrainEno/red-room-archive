---
import Page from '../layouts/Page.astro';
import PrevNext from '../components/PrevNext.astro';
import { formatDate } from '../../core/text.ts';
import type { ArticleDetail } from '../../shared/contracts.ts';
import { ARTICLES_PATH, tagPath } from '../../shared/routes.ts';

export interface Props {
  site: { name: string; url: string; email: string; articles: { label: string } };
  article: ArticleDetail;
  bodyMissing: boolean;
}
const { site, article, bodyMissing } = Astro.props;
const showToc = article.toc.length >= 3;
---
<Page title={`${article.title} — ${site.name}`} siteName={site.name} siteUrl={site.url} email={site.email} description={article.excerpt || site.name} image={article.cover} current={ARTICLES_PATH} type="article">
  <div class="article-wrap">
    <article class="prose">
      <p class="kicker"><a href={ARTICLES_PATH}>{site.articles.label}</a></p>
      <h1>{article.title}</h1>
      <p class="by">
        <time datetime={String(article.date).slice(0, 10)}>{formatDate(article.date)}</time>
        <span> · {article.readingMinutes} min read</span>
      </p>
      {article.tags.length > 0 && (
        <p class="tags">{article.tags.map((tag) => <a href={tagPath(tag)}>{tag}</a>)}</p>
      )}
      {article.cover && <img class="cover" src={article.cover} alt="" decoding="async" fetchpriority="high" />}
      {bodyMissing
        ? <p class="body-missing">This article could not be loaded from Notion right now. Please try again in a moment.</p>
        : <Fragment set:html={article.html} />}
    </article>
    {showToc && (
      <aside class="article-aside">
        <nav aria-label="Contents">
          <h2>Contents</h2>
          <ol>{article.toc.map((entry) => <li class={`toc-l${entry.level}`}><a href={`#${entry.id}`}>{entry.text}</a></li>)}</ol>
        </nav>
      </aside>
    )}
  </div>
  <PrevNext previous={article.previous ?? undefined} next={article.next ?? undefined} />
</Page>
