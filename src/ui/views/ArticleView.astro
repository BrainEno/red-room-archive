---
import Page from '../layouts/Page.astro';
import PrevNext from '../components/PrevNext.astro';
import ReadAloud from '../components/ReadAloud.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import { messages } from '../i18n.ts';
import { formatDate, isoDatetime } from '../../core/text.ts';
import type { ArticleDetail } from '../../shared/contracts.ts';
import { contentLang, localePath, type Locale } from '../../shared/i18n.ts';
import { ARTICLES_PATH, SUBSCRIBE_PATH, topicPath } from '../../shared/routes.ts';
import { absoluteUrl, articleLd, breadcrumbLd } from '../../shared/structured-data.ts';

export interface Props {
  site: { locale: Locale; name: string; url: string; email: string; newsletterSignup?: boolean };
  article: ArticleDetail;
  bodyMissing: boolean;
}
const { site, article, bodyMissing } = Astro.props;
const { locale } = site;
const t = messages(locale);
const showToc = article.toc.length >= 3;
/** The article's own language (from its title and excerpt), independent of the interface language. */
const lang = contentLang(`${article.title} ${article.excerpt}`);
const abs = (path: string) => absoluteUrl(site.url, localePath(path, locale));
const jsonLd = site.url
  ? [
      articleLd({
        url: abs(article.href),
        headline: article.title,
        description: article.excerpt,
        image: article.cover ? absoluteUrl(site.url, article.cover) : undefined,
        datePublished: isoDatetime(article.date),
        dateModified: article.updated,
        keywords: article.tags,
        inLanguage: lang,
        siteName: site.name,
        homeUrl: abs('/'),
      }),
      breadcrumbLd([
        { name: t.nav.home, url: abs('/') },
        { name: t.nav.articles, url: abs(ARTICLES_PATH) },
        { name: article.title, url: abs(article.href) },
      ]),
    ]
  : [];
---
<Page title={`${article.title} — ${site.name}`} siteName={site.name} siteUrl={site.url} email={site.email} newsletter={site.newsletterSignup} locale={locale} description={article.excerpt || site.name} image={article.cover} imageAlt={article.title} current={ARTICLES_PATH} type="article" published={isoDatetime(article.date)} modified={article.updated} tags={article.tags} jsonLd={jsonLd}>
  <div class="article-wrap">
    <article class="prose" lang={lang}>
      <p class="kicker" lang={locale}><a href={localePath(ARTICLES_PATH, locale)}>{t.articles.title}</a></p>
      <h1 data-article-title>{article.title}</h1>
      <p class="by" lang={locale}>
        <time datetime={isoDatetime(article.date)}>{formatDate(article.date, locale, { time: true })}</time>
        <span> · {t.article.readingTime(article.readingMinutes)}</span>
      </p>
      {article.topics.length > 0 && (
        <p class="tags">{article.topics.map((topic) => <a href={localePath(topicPath(topic.slug), locale)} lang={contentLang(topic.name)}>{topic.name}</a>)}</p>
      )}
      {article.cover && <img class="cover" src={article.cover} alt="" decoding="async" fetchpriority="high" />}
      {!bodyMissing && <ReadAloud locale={locale} />}
      {showToc && (
        <details class="article-inline-toc" lang={locale}>
          <summary>{t.article.contents}</summary>
          <nav aria-label={t.article.contents}>
            <ol lang={lang}>{article.toc.map((entry) => <li class={`toc-l${entry.level}`}><a href={`#${entry.id}`}>{entry.text}</a></li>)}</ol>
          </nav>
        </details>
      )}
      <div class:list={['article-body', { 'text-only': !article.cover }]} data-copy-label={t.article.copyCode} data-copied-label={t.article.copiedCode}>
        {bodyMissing
          ? <p class="body-missing" lang={locale}>{t.article.unavailable}</p>
          : <Fragment set:html={article.html} />}
      </div>
    </article>
    {showToc && (
      <aside class="article-aside">
        <nav aria-label={t.article.contents}>
          <h2>{t.article.contents}</h2>
          <ol lang={lang}>{article.toc.map((entry) => <li class={`toc-l${entry.level}`}><a href={`#${entry.id}`}>{entry.text}</a></li>)}</ol>
        </nav>
      </aside>
    )}
  </div>
  {site.newsletterSignup && (
    <aside class="letters-aside" aria-labelledby="letters-aside-h" lang={locale}>
      <p class="letters-kicker">{t.newsletter.kicker}</p>
      <h2 id="letters-aside-h">{t.newsletter.inlineHeading}</h2>
      <NewsletterForm locale={locale} source="article" />
      <p class="letters-more"><a href={localePath(SUBSCRIBE_PATH, locale)}>{t.newsletter.details} →</a></p>
    </aside>
  )}
  <PrevNext locale={locale} previous={article.previous ?? undefined} next={article.next ?? undefined} />
  <script>import '../scripts/site/article-enhance.ts';</script>
  <script>import '../scripts/site/newsletter.ts';</script>
</Page>
