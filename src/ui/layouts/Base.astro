---
/**
 * Document shell for every page: metadata, language alternates, fonts, base styles.
 * Pure presentation — receives everything through props.
 */
import '@fontsource-variable/archivo/wdth.css';
// The Latin cut every page sets its headings in: preloaded so it is usually there for the
// first paint and titles do not reflow (and push the article down) once it arrives.
import archivoLatin from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import { COPYRIGHT_PATH } from '../../shared/routes.ts';
import '../styles/base.css';
import '../styles/cjk.css';
import { DEFAULT_LOCALE, LOCALES, localizedPath, type Locale } from '../../shared/i18n.ts';
import { serializeJsonLd, type JsonLd } from '../../shared/structured-data.ts';
import { messages } from '../i18n.ts';

/** Default share card (public/og/card.jpg) for pages without a cover of their own. */
const DEFAULT_CARD = { src: '/og/card.jpg', width: 1200, height: 630 };

export interface Props {
  title: string;
  description?: string;
  /** Absolute site origin (from SITE_URL); enables canonical + og:url. */
  siteUrl?: string;
  siteName?: string;
  bodyClass?: string;
  noindex?: boolean;
  image?: string | null;
  type?: 'website' | 'article';
  locale?: Locale;
  /** Alt text of the share image (defaults to the site name for the default card). */
  imageAlt?: string;
  /** Articles: publish date, last edit (ISO) and topics, for `article:*` meta. */
  published?: string;
  modified?: string;
  tags?: string[];
  /** schema.org objects; rendered only when siteUrl is set (URLs must be absolute). */
  jsonLd?: JsonLd[];
  /** First-party aggregate pageview collector (public pages only). */
  analytics?: boolean;
  /** Public offline worker + connection status. */
  offline?: boolean;
}

const {
  title,
  description = '',
  siteUrl = '',
  siteName = '',
  bodyClass = '',
  noindex = false,
  image = null,
  type = 'website',
  locale = DEFAULT_LOCALE,
  imageAlt,
  published,
  modified,
  tags = [],
  jsonLd = [],
  analytics = false,
  offline = false,
} = Astro.props;

/** This page in a given language: the default language has the clean URL, others their prefix (`/zh-CN/…`). */
const neutralPath = Astro.locals.path ?? Astro.url.pathname;
const localized = (code: Locale) => {
  if (!siteUrl) return undefined;
  return new URL(localizedPath(neutralPath, code), siteUrl).toString();
};
const canonical = localized(locale);
const card = image ? { src: image, width: 0, height: 0 } : noindex ? null : DEFAULT_CARD;
const ogImage = card && siteUrl ? new URL(card.src, siteUrl).toString() : (card?.src ?? null);
const ogImageAlt = image ? imageAlt || title : siteName || title;
const otherLocales = LOCALES.filter((code) => code !== locale);
const structured = siteUrl && jsonLd.length ? serializeJsonLd(jsonLd) : '';
const rightsPolicy = siteUrl ? new URL(localizedPath(COPYRIGHT_PATH, locale), siteUrl).toString() : localizedPath(COPYRIGHT_PATH, locale);
const t = messages(locale);
---
<!doctype html>
<html lang={locale}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  {noindex && <meta name="robots" content="noindex" />}
  {canonical && <link rel="canonical" href={canonical} />}
  <meta name="theme-color" content="#0a0506" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <link rel="icon" href="/favicon.ico" sizes="16x16 32x32" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
  <link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />
  {siteName && <meta name="copyright" content={`© ${new Date().getFullYear()} ${siteName}. All rights reserved.`} />}
  {/* W3C TDMRep: text-and-data-mining rights are reserved; the policy is the copyright page. */}
  <meta name="tdm-reservation" content="1" />
  <meta name="tdm-policy" content={rightsPolicy} />
  <meta property="og:type" content={type} />
  <meta property="og:title" content={title} />
  {siteName && <meta property="og:site_name" content={siteName} />}
  {description && <meta property="og:description" content={description} />}
  {canonical && <meta property="og:url" content={canonical} />}
  {ogImage && <meta property="og:image" content={ogImage} />}
  {ogImage && card?.width ? <meta property="og:image:width" content={String(card.width)} /> : null}
  {ogImage && card?.height ? <meta property="og:image:height" content={String(card.height)} /> : null}
  {ogImage && <meta property="og:image:alt" content={ogImageAlt} />}
  {type === 'article' && published && <meta property="article:published_time" content={published} />}
  {type === 'article' && modified && <meta property="article:modified_time" content={modified} />}
  {type === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}
  <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
  <meta name="twitter:title" content={title} />
  {description && <meta name="twitter:description" content={description} />}
  {ogImage && <meta name="twitter:image" content={ogImage} />}
  {ogImage && <meta name="twitter:image:alt" content={ogImageAlt} />}
  <link rel="alternate" type="application/rss+xml" title={`${siteName || 'Articles'} — RSS`} href="/rss.xml" />
  {/* Chinese display cut (scripts/fonts/build-display-sc.py): ~30 KB of @font-face rules, loaded without
       blocking render (media="print" until scripts/site/async-css.ts switches it, no inline handler so the CSP
       holds); the browser fetches only the unicode-range slices a page's display text needs. */}
  <link rel="stylesheet" href="/fonts/display-sc/display-sc.css" media="print" data-async-css />
  <noscript><link rel="stylesheet" href="/fonts/display-sc/display-sc.css" /></noscript>
  {canonical && !noindex && LOCALES.map((code) => <link rel="alternate" hreflang={code} href={localized(code)} />)}
  {canonical && !noindex && <link rel="alternate" hreflang="x-default" href={localized(DEFAULT_LOCALE)} />}
  <meta property="og:locale" content={locale.replace('-', '_')} />
  {!noindex && otherLocales.map((code) => <meta property="og:locale:alternate" content={code.replace('-', '_')} />)}
  {structured && <script type="application/ld+json" set:html={structured} />}
</head>
<body class={bodyClass}><slot />
  {offline && <p class="offline-status" data-offline-status role="status" hidden>{t.offline.notice}</p>}
  <script>
    import '../scripts/site/async-css.ts';
    import '../scripts/site/settings-refresh.ts';
  </script>
  {offline && <script>import '../scripts/site/offline.ts';</script>}
  {analytics && <script>import '../scripts/site/analytics.ts';</script>}
</body>
</html>
