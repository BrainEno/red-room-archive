---
/**
 * Layout for every inner (non-homepage) page: skip link, site header with
 * navigation, main landmark and footer.
 */
import Base from './Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { messages } from '../i18n.ts';
import type { Locale } from '../../shared/i18n.ts';
import '../styles/pages.css';

export interface Props {
  title: string;
  siteName: string;
  locale: Locale;
  siteUrl?: string;
  email?: string;
  description?: string;
  current?: string;
  image?: string | null;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const { title, siteName, locale, siteUrl, email = '', description, current, image, type, noindex } = Astro.props;
const t = messages(locale);
---
<Base title={title} siteName={siteName} siteUrl={siteUrl} description={description} image={image} type={type} noindex={noindex} locale={locale} bodyClass="plain">
  <a class="skip" href="#content">{t.page.skip}</a>
  <SiteHeader siteName={siteName} current={current} locale={locale} />
  <main id="content" class="page">
    <slot />
  </main>
  <SiteFooter siteName={siteName} email={email} locale={locale} />
</Base>
