---
import { messages } from '../i18n.ts';
import { contentLang, localePath, type Locale } from '../../shared/i18n.ts';

export interface Props {
  locale: Locale;
  previous?: { title: string; href: string };
  next?: { title: string; href: string };
}
const { locale, previous, next } = Astro.props;
const t = messages(locale).article;
---
{(previous || next) && (
  <nav class="prevnext" aria-label={t.more}>
    {previous ? (
      <a rel="prev" href={localePath(previous.href, locale)}><small>{t.previous}</small><span lang={contentLang(previous.title)}>{previous.title}</span></a>
    ) : <span />}
    {next ? (
      <a rel="next" href={localePath(next.href, locale)}><small>{t.next}</small><span lang={contentLang(next.title)}>{next.title}</span></a>
    ) : <span />}
  </nav>
)}
