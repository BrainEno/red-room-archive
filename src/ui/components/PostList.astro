---
import type { PostSummary } from '../../shared/contracts.ts';
import { formatDate } from '../../core/text.ts';

export interface Props {
  posts: PostSummary[];
  empty?: string;
  showExcerpt?: boolean;
}
const { posts, empty = 'No journal entries yet.', showExcerpt = false } = Astro.props;
---
{posts.length ? (
  <ol class="journal-list">
    {posts.map((post) => (
      <li>
        <a class="journal-entry" href={post.href}>
          <time class="journal-date" datetime={String(post.created).slice(0, 10)}>{formatDate(post.created)}</time>
          <span class="journal-title">{post.title}</span>
          <span class="journal-tags">{post.tags.join(' / ')}</span>
          <span class="journal-arrow" aria-hidden="true">↗</span>
          {showExcerpt && post.excerpt && <span class="journal-excerpt">{post.excerpt}</span>}
        </a>
      </li>
    ))}
  </ol>
) : (
  <p class="journal-empty">{empty}</p>
)}
