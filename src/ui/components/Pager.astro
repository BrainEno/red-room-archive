---
import { messages } from '../i18n.ts';
import type { Locale } from '../../shared/i18n.ts';

export interface Props {
  page: number;
  pages: number;
  locale: Locale;
  /** Builds the URL for a page number. */
  href: (page: number) => string;
}
const { page, pages, locale, href } = Astro.props;
const t = messages(locale).pager;
---
{pages > 1 && (
  <nav class="pager" aria-label={t.label}>
    {page > 1 ? <a rel="prev" href={href(page - 1)}>{t.newer}</a> : <span />}
    <span class="pager-pos">{page} / {pages}</span>
    {page < pages ? <a rel="next" href={href(page + 1)}>{t.older}</a> : <span />}
  </nav>
)}
