---
import { messages } from '../i18n.ts';
import type { Locale } from '../../shared/i18n.ts';
const { locale } = Astro.props as { locale: Locale };
const t = messages(locale).article;
---
{/* Rendered in place but invisible (data-pending) so the article does not jump
    when the script reveals it; browsers that cannot speak remove it. */}
<div class="read-aloud" lang={locale} data-pending data-read-aloud
  data-listen={t.listen} data-pause={t.pause} data-resume={t.resume}
  data-listening={t.listening} data-paused={t.paused} data-finished={t.finished}
  data-stopped={t.stopped} data-error={t.speechError} data-hint={t.listenHint}>
  <div class="read-aloud-controls">
    <button type="button" class="read-aloud-play" data-play>
      <span class="read-aloud-icon" aria-hidden="true"><svg class="icon-play" viewBox="0 0 24 24"><path d="M8 5.2 19 12 8 18.8z" fill="currentColor"/></svg><svg class="icon-pause" viewBox="0 0 24 24"><path d="M7.5 5.5h3v13h-3zm6 0h3v13h-3z" fill="currentColor"/></svg></span>
      <span class="read-aloud-text">
        <span class="read-aloud-label"><span data-play-label>{t.listen}</span><span class="read-aloud-wave" aria-hidden="true"><i></i><i></i><i></i><i></i></span></span>
        <span class="read-aloud-caption" aria-hidden="true" data-caption>{t.listenHint}</span>
      </span>
    </button>
    <button type="button" class="read-aloud-stop" data-stop hidden aria-label={t.stop} title={t.stop}><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M7 7h10v10H7z" fill="currentColor"/></svg></button>
    <label class="read-aloud-speed"><span class="read-aloud-speed-k" aria-hidden="true">{t.speed}</span>
      <select data-speed aria-label={t.speed}>
        <option value="0.5">0.5×</option>
        <option value="0.75">0.75×</option>
        <option value="1" selected>1×</option>
        <option value="1.25">1.25×</option>
        <option value="1.5">1.5×</option>
        <option value="2">2×</option>
      </select>
    </label>
  </div>
  <input class="read-aloud-seek" data-seek type="range" min="0" max="1000" step="1" value="0" disabled
    aria-label={t.seek} title={t.seekHint} />
  <span class="sr" role="status" aria-live="polite" data-status></span>
</div>
<script>
  import '../scripts/site/read-aloud.ts';
</script>
