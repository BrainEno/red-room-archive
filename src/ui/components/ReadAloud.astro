---
import { messages } from '../i18n.ts';
import type { Locale } from '../../shared/i18n.ts';
const { locale } = Astro.props as { locale: Locale };
const t = messages(locale).article;
---
<div class="read-aloud" lang={locale} hidden data-read-aloud
  data-listen={t.listen} data-pause={t.pause} data-resume={t.resume}
  data-listening={t.listening} data-paused={t.paused} data-finished={t.finished}
  data-stopped={t.stopped} data-error={t.speechError}>
  <div class="read-aloud-controls">
    <button type="button" class="read-aloud-play" data-play>
      <span class="read-aloud-icon" aria-hidden="true"><svg class="icon-play" viewBox="0 0 24 24"><path d="M9 5.5 19 12 9 18.5z" fill="currentColor"/></svg><svg class="icon-pause" viewBox="0 0 24 24"><path d="M8 6h3v12H8zm5 0h3v12h-3z" fill="currentColor"/></svg></span>
      <span data-play-label>{t.listen}</span>
    </button>
    <button type="button" class="read-aloud-stop" data-stop hidden aria-label={t.stop} title={t.stop}><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M7 7h10v10H7z" fill="currentColor"/></svg></button>
    <label class="read-aloud-speed"><span class="sr">{t.speed}</span>
      <select data-speed aria-label={t.speed}>
        <option value="0.8">0.8×</option>
        <option value="1" selected>1×</option>
        <option value="1.2">1.2×</option>
        <option value="1.5">1.5×</option>
      </select>
    </label>
  </div>
  <span class="sr" role="status" aria-live="polite" data-status></span>
</div>
<script>
  import '../scripts/site/read-aloud.ts';
</script>
