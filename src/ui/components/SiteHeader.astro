---
import { ARTICLES_PATH } from '../../shared/routes.ts';

export interface Props {
  siteName: string;
  /** Path prefix of the active section, e.g. `/articles` or `/search`. */
  current?: string;
}

const { siteName, current = '' } = Astro.props;
const links = [
  { href: ARTICLES_PATH, label: 'Articles' },
  { href: '/search', label: 'Search' },
];
---
<header class="site-header">
  <a class="site-brand" href="/">{siteName}</a>
  <nav aria-label="Site">
    {links.map((link) => (
      <a href={link.href} aria-current={current === link.href ? 'page' : undefined}>{link.label}</a>
    ))}
  </nav>
</header>
