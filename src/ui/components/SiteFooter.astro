---
import { messages } from '../i18n.ts';
import { localePath, type Locale } from '../../shared/i18n.ts';
import { ARCHIVE_PATH, SUBSCRIBE_PATH } from '../../shared/routes.ts';

export interface Props {
  siteName: string;
  locale: Locale;
  email?: string;
  /** Newsletter sign-up link (hidden unless the site setting is on). */
  newsletter?: boolean;
}
const { siteName, locale, email = '', newsletter = false } = Astro.props;
const t = messages(locale);
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <span>© {year} {siteName}</span>
  <nav aria-label="Footer">
    {email && <a href={`mailto:${email}`}>{email}</a>}
    <a href={localePath(ARCHIVE_PATH, locale)}>{t.nav.archive}</a>
    {newsletter && <a href={localePath(SUBSCRIBE_PATH, locale)}>{t.newsletter.footer}</a>}
    <a href="/rss.xml">RSS</a>
    <a href={localePath('/', locale)}>{t.nav.home}</a>
  </nav>
</footer>
