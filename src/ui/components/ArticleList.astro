---
import type { ArticleSummary } from '../../shared/contracts.ts';
import { contentLang, type Locale } from '../../shared/i18n.ts';
import { formatDate, isoDatetime } from '../../core/text.ts';

export interface Props {
  articles: ArticleSummary[];
  locale: Locale;
  empty: string;
  showExcerpt?: boolean;
  showCovers?: boolean;
}
const { articles, locale, empty, showExcerpt = false, showCovers = false } = Astro.props;
---
{articles.length ? (
  <ol class="article-list">
    {articles.map((article) => {
      const cover = showCovers && article.cover;
      return (
        <li>
          <a class:list={['article-entry', { 'has-cover': cover }]} href={article.href}>
            <time class="article-date" datetime={isoDatetime(article.date)}>{formatDate(article.date, locale)}</time>
            <span class="article-title" lang={contentLang(article.title)}>{article.title}</span>
            <span class="article-tags">{article.tags.join(' / ')}</span>
            {cover ? <img class="article-cover" src={cover} alt="" loading="lazy" decoding="async" /> : <span class="article-arrow" aria-hidden="true">↗</span>}
            {showExcerpt && article.excerpt && <span class="article-excerpt" lang={contentLang(article.excerpt)}>{article.excerpt}</span>}
          </a>
        </li>
      );
    })}
  </ol>
) : (
  <p class="article-empty">{empty}</p>
)}
