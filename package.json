{
  "name": "red-room-archive",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "start": "node dist/server/entry.mjs",
    "test": "node --experimental-strip-types --no-warnings --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build && npm run test:render",
    "test:render": "node --test tests/integration/*.test.mjs",
    "build:static": "npm run build && node scripts/static-snapshot.mjs",
    "test:ui": "npm run build && npm run test:ui:prepare && npm run test:ui:built",
    "test:ui:prepare": "UI_TEST_SNAPSHOT=1 SHOW_NEWSLETTER_SIGNUP=1 SITE_URL=https://example.invalid STATIC_DEMO=1 NOTION_TOKEN= NOTION_API_SECRET= NOTION_DATABASE_ID= DATABASE_ID= NOTION_DB_WRITING= node scripts/static-snapshot.mjs",
    "test:ui:built": "playwright test",
    "test:visual:candidates": "playwright test --config=playwright.visual.config.mjs",
    "test:visual:compare": "VISUAL_COMPARE=1 playwright test --config=playwright.visual.config.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.9",
    "@fontsource-variable/archivo": "^5.3.0",
    "@netlify/blobs": "^11.1.7",
    "astro": "^7.4.4",
    "better-sqlite3": "^11.7.0",
    "gsap": "^3.12.7",
    "highlight.js": "^11.12.0",
    "lenis": "^1.1.20",
    "temml": "^0.14.0",
    "three": "^0.171.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@docx-editor.dev/fonts-cjk": "2.33.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@playwright/test": "^1.56.1",
    "@types/better-sqlite3": "^7.6.11",
    "@types/three": "^0.171.0",
    "parse5": "^7.3.0",
    "typescript": "^5.6.0"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "sharp@0.35.5": true
  },
  "engines": {
    "node": ">=22.23.4",
    "npm": ">=9.6.5"
  }
}
