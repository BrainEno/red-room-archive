{
  "name": "red-room-archive",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "start": "node dist/server/entry.mjs",
    "test": "node --experimental-strip-types --no-warnings --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.9",
    "@fontsource-variable/archivo": "^5.3.0",
    "astro": "^7.4.4",
    "better-sqlite3": "^11.7.0",
    "gsap": "^3.12.7",
    "lenis": "^1.1.20",
    "three": "^0.171.0"
  },
  "devDependencies": {
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@types/better-sqlite3": "^7.6.11",
    "@types/three": "^0.171.0",
    "typescript": "^5.6.0"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "sharp@0.35.5": true
  },
  "engines": {
    "node": ">=22.23.4",
    "npm": ">=9.6.5"
  }
}
