{
  "name": "red-room-archive",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "start": "node dist/server/entry.mjs",
    "test": "node --experimental-strip-types --no-warnings --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@astrojs/node": "^9.0.0",
    "astro": "^5.1.0",
    "better-sqlite3": "^11.7.0",
    "gsap": "^3.12.7",
    "lenis": "^1.1.20",
    "three": "^0.171.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/three": "^0.171.0",
    "typescript": "^5.6.0"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "esbuild@0.27.7": true,
    "esbuild@0.25.12": true,
    "sharp@0.34.5": true
  }
}
